package AULA_02.CONTA;

import java.util.Scanner;

public class main {
    public static void main(String[] args) {
        Banco banco = new Banco();
        Scanner menu = new Scanner(System.in);

        int opcao;
        do {
            System.out.println("\n=== BANCO ===");
            System.out.println("1 - Criar conta");
            System.out.println("2 - Sacar");
            System.out.println("3 - Depositar");
            System.out.println("4 - Transferir");
            System.out.println("5 - Consultar saldo");
            System.out.println("6 - Ver extrato");
            System.out.println("7 - Aplicar rendimento");
            System.out.println("8 - Listar contas");
            System.out.println("0 - Sair");
            System.out.print("Escolha: ");

            opcao = menu.nextInt();
            menu.nextLine();

            switch (opcao) {
                case 1:
                    cadastrarConta(banco, menu);
                    break;
                case 2:
                    realizarSaque(banco, menu);
                    break;
                case 3:
                    realizarDeposito(banco, menu);
                    break;
                case 4:
                    realizarTransferencia(banco, menu);
                    break;
                case 5:
                    consultarSaldo(banco, menu);
                    break;
                case 6:
                    verExtrato(banco, menu);
                    break;
                case 7:
                    aplicarRendimento(banco, menu);
                    break;
                case 8:
                    banco.listarContas();
                    break;
                case 0:
                    System.out.println("Até logo!");
                    break;
                default:
                    System.out.println("Opção inválida.");
            }
        } while (opcao != 0);

        menu.close();
    }

    private static void cadastrarConta(Banco banco, Scanner menu) {
        System.out.print("Nome do titular: ");
        String nome = menu.nextLine();
        System.out.print("CPF: ");
        String cpf = menu.nextLine();
        System.out.print("Data de nascimento: ");
        String dataNascimento = menu.nextLine();

        banco.criarConta(nome, cpf, dataNascimento);
    }

    private static void realizarSaque(Banco banco, Scanner menu) {
        System.out.print("Número da conta: ");
        String numero = menu.nextLine();
        System.out.print("Valor do saque: ");
        double valor = menu.nextDouble();
        menu.nextLine();

        banco.sacar(numero, valor);
    }

    private static void realizarDeposito(Banco banco, Scanner menu) {
        System.out.print("Número da conta: ");
        String numero = menu.nextLine();
        System.out.print("Valor do depósito: ");
        double valor = menu.nextDouble();
        menu.nextLine();

        banco.depositar(numero, valor);
    }

    private static void realizarTransferencia(Banco banco, Scanner menu) {
        System.out.print("Número da conta origem: ");
        String origem = menu.nextLine();
        System.out.print("Número da conta destino: ");
        String destino = menu.nextLine();
        System.out.print("Valor da transferência: ");
        double valor = menu.nextDouble();
        menu.nextLine();

        banco.transferir(origem, destino, valor);
    }

    private static void consultarSaldo(Banco banco, Scanner menu) {
        System.out.print("Número da conta: ");
        String numero = menu.nextLine();
        double saldo = banco.consultarSaldo(numero);
        if (saldo >= 0) {
            System.out.println("Saldo: R$ " + saldo);
        }
    }

    private static void verExtrato(Banco banco, Scanner menu) {
        System.out.print("Número da conta: ");
        String numero = menu.nextLine();
        banco.exibirExtrato(numero);
    }

    private static void aplicarRendimento(Banco banco, Scanner menu) {
        System.out.print("Número da conta: ");
        String numero = menu.nextLine();
        System.out.print("Percentual de rendimento (%): ");
        double percentual = menu.nextDouble();
        menu.nextLine();

        banco.aplicarRendimento(numero, percentual);
    }
}
